              "audience": "",
              "username": "",
              "password": "",
              "clientAuth": "body"
            }
          },
          "body": {
            "mode": "json",
            "raw": "{\n  \"orderId\": \"{{$guid}}\",\n  \"customer\": \"{{username}}\",\n  \"items\": [\n    { \"sku\": \"BOOK-1\", \"qty\": 2, \"price\": 9.99 }\n  ],\n  \"total\": 19.98,\n  \"express\": true\n}",
            "form": [],
            "multipart": [],
            "binaryPath": "",
            "graphql": {
              "query": "",
              "variables": ""
            }
          },
          "assertions": [
            {
              "id": "a_4ce77c174e24",
              "enabled": true,
              "source": "status",
              "property": "",
              "operator": "equals",
              "expected": "200"
            },
            {
              "id": "a_1e8a0e5a51b3",
              "enabled": true,
              "source": "header",
              "property": "Content-Type",
              "operator": "contains",
              "expected": "application/json"
            },
            {
              "id": "a_6e73cb90cf5c",
              "enabled": true,
              "source": "jsonpath",
              "property": "$.json.customer",
              "operator": "equals",
              "expected": "{{username}}"
            },
            {
              "id": "a_7aee17d44430",
              "enabled": true,
              "source": "jsonpath",
              "property": "$.json.items[0].qty",
              "operator": "equals",
              "expected": "2"
            },
            {
              "id": "a_32ada6636b61",
              "enabled": true,
              "source": "jsonpath",
              "property": "$.json.total",
              "operator": "gt",
              "expected": "10"
            },
            {
              "id": "a_9d1c7e00742b",
              "enabled": true,
              "source": "jsonpath",
              "property": "$.json.express",
              "operator": "isType",
              "expected": "boolean"
            },
            {
              "id": "a_4bf1bd9955f4",
              "enabled": true,
              "source": "responseTime",
              "property": "",
              "operator": "lt",
              "expected": "2000"
            },
            {
              "id": "a_7e452c6eb850",
              "enabled": true,
              "source": "schema",
              "property": "",
              "operator": "validSchema",
              "expected": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"method\",\n    \"json\"\n  ],\n  \"properties\": {\n    \"method\": {\n      \"const\": \"POST\"\n    },\n    \"json\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"orderId\",\n        \"items\",\n        \"total\"\n      ],\n      \"properties\": {\n        \"orderId\": {\n          \"type\": \"string\",\n          \"format\": \"uuid\"\n        },\n        \"items\": {\n          \"type\": \"array\",\n          \"minItems\": 1\n        },\n        \"total\": {\n          \"type\": \"number\"\n        }\n      }\n    }\n  }\n}"
            }
