        {
          "id": "r_2221e4e22ff0",
          "type": "request",
          "name": "Scripts: before and after",
          "description": "Optional JavaScript. The pre-request script adds a header and stores a variable; the post-response script runs test() checks (shown in the Tests tab) and writes to the Console tab.",
          "method": "POST",
          "url": "{{baseUrl}}/anything/scripts",
          "params": [],
          "headers": [],
          "auth": {
            "type": "inherit",
            "basic": {
              "username": "",
              "password": ""
            },
            "bearer": {
              "token": ""
            },
            "apikey": {
              "key": "X-API-Key",
              "value": "",
              "in": "header"
            },
            "oauth2": {
              "grantType": "client_credentials",
              "tokenUrl": "",
              "clientId": "",
              "clientSecret": "",
              "scope": "",
              "audience": "",
              "username": "",
              "password": "",
              "clientAuth": "body"
            }
          },
          "body": {
            "mode": "json",
            "raw": "{\n  \"hello\": \"scripts\"\n}",
            "form": [],
            "multipart": [],
            "binaryPath": "",
            "graphql": {
              "query": "",
              "variables": ""
            }
          },
          "assertions": [
            {
              "id": "a_4d1c01eea07b",
              "enabled": true,
              "source": "status",
              "property": "",
              "operator": "equals",
              "expected": "200"
            }
          ],
          "extract": [],
          "scripts": {
            "pre": "// Runs before the request is sent: change the request or set variables.\nconst traceId = \"trace-\" + Date.now();\nvars.set(\"traceId\", traceId);\nrequest.headers[\"X-Trace-Id\"] = traceId;\nconsole.log(\"Sending with trace id\", traceId);",
            "post": "// Runs after the response arrives. test() results appear in the Tests tab.\nconst data = response.json();\ntest(\"status is 200\", () => {\n    expect(response.status).toBe(200);\n});\ntest(\"the trace id header was sent\", () => {\n    expect(data.headers[\"x-trace-id\"]).toBe(vars.get(\"traceId\"));\n});\ntest(\"body was echoed\", () => {\n    expect(data.json).toHaveProperty(\"hello\");\n    expect(data.json.hello).toEqual(\"scripts\");\n});\nconsole.log(\"Echoed path:\", data.path);"
          },
          "settings": {
            "timeoutMs": null,
            "followRedirects": null,
            "verifyTls": null
          }
        }
      ]
    }
