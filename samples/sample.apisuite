        {
          "id": "r_4722edade948",
          "type": "request",
          "name": "Post JSON with assertions",
          "description": "A JSON body with variables: {{username}} comes from the suite variables and {{$guid}} is a dynamic variable (a new UUID each time). The assertions check the status, a header, values inside the JSON (JSONPath), the response time and the shape of the whole body (JSON Schema).",
          "method": "POST",
          "url": "{{baseUrl}}/anything/orders",
          "params": [],
          "headers": [],
          "auth": {
            "type": "inherit",
            "basic": {
              "username": "",
              "password": ""
            },
            "bearer": {
              "token": ""
            },
            "apikey": {
              "key": "X-API-Key",
              "value": "",
