{
  "name": "api-tester",
  "productName": "API Tester",
  "desktopName": "api-tester.desktop",
  "version": "1.0.1",
  "description": "Standalone desktop API testing tool: requests, environments, assertions, suite runner and shareable suite files",
  "main": "src/main/main.js",
  "bin": {
    "api-tester": "src/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/launch.js",
    "cli": "node src/cli.js",
    "echo": "node src/cli.js echo-server",
    "sample": "node src/cli.js run samples/sample.apisuite --echo-server",
    "samples": "node scripts/make-samples.js",
    "samples:check": "node scripts/make-samples.js --check",
    "icon": "node scripts/render-icon.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --mac --win --linux",
    "docker:build": "docker build -t api-tester ."
  },
  "build": {
    "appId": "com.apitester.app",
    "productName": "API Tester",
    "artifactName": "API-Tester-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "afterPack": "./build/afterPack.js",
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "fileAssociations": [
      {
        "ext": "apisuite",
        "name": "API Tester Suite",
        "description": "API Tester suite",
        "mimeType": "application/x-apisuite",
        "role": "Editor",
        "isPackage": false
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "build/bin/api-tester",
          "to": "bin/api-tester"
        },
        {
          "from": "node_modules/electron/LICENSE",
          "to": "LICENSE.electron.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        }
      ],
      "extendInfo": {
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.apitester.apisuite",
            "UTTypeDescription": "API Tester Suite",
            "UTTypeConformsTo": [
              "public.json",
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "apisuite"
              ],
              "public.mime-type": "application/x-apisuite"
            }
          }
        ]
      }
    },
    "dmg": {
      "title": "API Tester ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 80,
          "type": "file",
          "path": "build/mac/Read Me First.txt"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "build/bin/api-tester.cmd",
          "to": "bin/api-tester.cmd"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "API Tester",
      "artifactName": "API-Tester-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "API-Tester-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableName": "api-tester",
      "category": "Development",
      "synopsis": "API testing tool: requests, assertions, suite runner",
      "description": "Standalone API testing tool: send HTTP requests, use environments and variables, add no-code assertions, chain requests, run suites with data files and share suites as files.",
      "maintainer": "Manjunagouda Hombaradi <manjuhombaradi@gmail.com>",
      "icon": "build/icons"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libx11-xcb1"
      ],
      "appArmorProfile": "build/linux/apparmor-profile.tpl"
    },
    "copyright": "Copyright © 2026 Manjunagouda Hombaradi"
  },
  "license": "MIT",
  "private": true,
  "author": {
    "name": "Manjunagouda Hombaradi",
    "email": "manjuhombaradi@gmail.com"
  },
  "homepage": "https://github.com/Manjuhombaradi/api-tester",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manjuhombaradi/api-tester.git"
  },
  "bugs": {
    "url": "https://github.com/Manjuhombaradi/api-tester/issues"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "form-data": "^4.0.6",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "js-yaml": "^5.5.0",
    "jsonpath-plus": "^11.2.1",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0"
  }
}
